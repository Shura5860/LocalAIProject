{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "AURA Studio",
  "version": "2.4.0",
  "identifier": "com.aura.studio",
  "build": {
    "frontendDist": "../src",
    "devUrl": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AURA Studio",
        "width": 1150,
        "height": 780,
        "minWidth": 650,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:8000; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; connect-src 'self' http://127.0.0.1:8000; img-src 'self' data:; font-src 'self' https://cdn.jsdelivr.net data:"
    }
  },
  "bundle": {
    "active": false
  }
}
